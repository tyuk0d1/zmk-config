#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_hu.h"

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUNC    3
#define NAV     4
#define HUN     5
#define MACRO   6

/ {
    macros {
        ZMK_MACRO(
            macro_user,
            bindings =
                <&kp A &kp D &kp HU_N0 &kp HU_N0 &kp HU_N5 &kp HU_BACKSLASH &kp HU_Z &kp HU_N0 &kp HU_N0 &kp HU_N1 &kp T &kp X &kp N &kp J>;
        )
        ZMK_MACRO(
            macro_pwd,
            bindings =
                <&macro_tap &kp L &kp I &kp T &kp L &kp E &kp HU_N0 &kp HU_N8>,
                <&macro_press &kp LSHFT>,
                <&macro_tap &kp W &kp I &kp N &kp G>,
                <&macro_release &kp LSHFT>,
                <&macro_tap &kp HU_MINUS>;
        )
        ZMK_MACRO(
            macro_mail,
            bindings =
                <&kp HU_Z &kp O &kp L &kp T &kp A &kp N &kp HU_DOT &kp T &kp HU_Y &kp U &kp K &kp O &kp D &kp I &kp HU_DOT &kp E &kp X &kp T &kp HU_AT &kp S &kp I &kp E &kp M &kp E &kp N &kp S &kp HU_MINUS &kp H &kp E &kp A &kp L &kp T &kp H &kp I &kp N &kp E &kp E &kp R &kp S &kp HU_DOT &kp C &kp O &kp M>;
        )
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &none &kp      Q &kp      W &kp       E &kp         R &kp T                         &kp Y        &kp        U &kp       I  &kp      O    &kp                 P &none
                &none &mt LWIN A &mt LALT S &mt LCTRL D &mt LSHFT   F &kp G                         &kp H        &mt LSHIFT J &mt LCTRL K  &mt LALT L    &mt LWIN HU_BACKSLASH &none
                &none &kp      Z &kp      X &kp       C &kp         V &kp B                         &kp N        &kp        M &kp HU_COMMA &kp HU_PERIOD &kp HU_MINUS          &none
                                            &lt HUN ESC &lt NAV SPACE &lt SYM TAB                   &lt FUNC RET &lt NUM BSPC &lt MACRO DEL
            >;
        };

        num_layer {
            bindings = <
                &none &kp KP_DIVIDE   &kp HU_N7 &kp HU_N8 &kp HU_N9 &kp KP_MINUS                    &trans &trans &trans &trans &trans &none
                &none &kp KP_MULTIPLY &kp HU_N4 &kp HU_N5 &kp HU_N6 &kp KP_PLUS                     &trans &trans &trans &trans &trans &none
                &none &kp HU_N0       &kp HU_N1 &kp HU_N2 &kp HU_N3 &kp KP_DOT                      &trans &trans &trans &trans &trans &none
                                             &trans &trans &trans                                   &trans &trans &trans
            >;
        };

        sym_layer {
            bindings = <
                &none &trans &trans &trans &trans &trans                                            &kp HU_AMPS &kp HU_PIPE &kp HU_LBKT &kp HU_RBKT &kp HU_EURO   &none
                &none &trans &trans &trans &trans &trans                                            &trans      &kp HU_SEMI &kp HU_LBRC &kp HU_RBRC &kp HU_DOLLAR &none
                &none &trans &trans &trans &trans &trans                                            &trans      &kp HU_HASH &kp HU_LT   &kp HU_GT   &kp HU_AT     &none
                                    &trans &trans &trans                                            &trans      &trans      &trans
            >;
        };

        func_layer {
            bindings = <
                &none &trans &kp F7 &kp F8 &kp F9 &kp F10                                           &kp K_SLEEP  &kp C_BRI_DN &kp C_BRI_UP &kp K_VOL_DN &kp K_VOL_UP &none
                &none &trans &kp F4 &kp F5 &kp F6 &kp F11                                           &bt BT_CLR   &trans       &trans       &trans       &trans       &none
                &none &trans &kp F1 &kp F2 &kp F3 &kp F12                                           &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none
                                    &trans &trans  &trans                                           &trans &trans &trans
            >;
        };

        nav_layer {
            bindings = <
                &none &trans &trans &trans &trans &trans                                            &trans &kp HOME &kp PG_DN       &kp PG_UP &kp END   &none
                &none &trans &trans &trans &trans &trans                                            &trans &kp LEFT &kp DOWN        &kp UP    &kp RIGHT &none
                &none &trans &trans &trans &trans &trans                                            &trans &trans   &kp PAUSE_BREAK &kp INS   &trans    &none
                                    &trans &trans &trans                                            &trans &trans   &trans
            >;
        };

        hun_layer {
            bindings = <
                &none &trans &trans &trans &trans &trans                                            &trans &kp HU_O_UMLAUT &kp HU_U_UMLAUT       &kp HU_O_ACUTE        &trans &none
                &none &trans &trans &trans &trans &trans                                            &trans &kp HU_I_ACUTE  &kp HU_O_DOUBLE_ACUTE &kp HU_U_ACUTE        &trans &none
                &none &trans &trans &trans &trans &trans                                            &trans &kp HU_E_ACUTE  &kp HU_A_ACUTE        &kp HU_U_DOUBLE_ACUTE &trans &none
                                    &trans &trans &trans                                            &trans &trans &trans
            >;
        };

        macro_layer {
            bindings = <
                &none &trans &trans       &trans &trans &trans                                            &trans &trans      &trans &trans &macro_pwd &none
                &none &trans &trans       &trans &trans &trans                                            &trans &trans      &trans &trans &trans     &none
                &none &trans &trans       &trans &trans &trans                                            &trans &trans      &trans &trans &trans     &none
                                          &trans &trans &trans                                            &trans &trans      &trans
            >;
        };
    };
};
